{
  "project": "ECO-PRO",
  "repo": "nikalimp/eco-pro",
  "site_dir": ".",
  "targets": {
    "test": {
      "url": "https://eco-pro.nikalimp.ru",
      "ftp_dir_secret": "FTP_DIR",
      "indexable": false
    },
    "prod": {
      "url": "https://eco-system.pro",
      "ftp_dir_secret": "FTP_DIR_PROD",
      "indexable": true
    }
  },
  "url": "https://eco-pro.nikalimp.ru",
  "adapter": "ssh-ftp",
  "mode": "auto",
  "content_dir": "content",
  "factory": "content/factory/content.config.json",
  "schedule": {
    "daily": "09:05",
    "weekly": "mon 08:50",
    "tz": "Europe/Moscow",
    "days": "1-5"
  },
  "version": 2,
  "notes": "Тест (eco-pro.nikalimp.ru, noindex) и прод (eco-system.pro, индексируется) параллельно через deploy-kit 2.0.0. REG.RU: SSH из Actions закрыт, выкладка идёт по FTP.",
  "out_dir": "out",
  "app_path": "",
  "rsync_exclude": "api/config.php api/logs/",
  "manual_script": "scripts/deploy-site.sh"
}
