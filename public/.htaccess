# Apache (REG.RU, Beget, Timeweb shared): HTTPS, адреса со слешем, 301 со старого сайта на Tilda
Options -Indexes
RewriteEngine On

# HTTP → HTTPS делает nginx хостинга (ispmanager: настройки сайта → «Перенаправлять HTTP-запросы в HTTPS»).
# Здесь его нет: Apache за nginx всегда видит HTTP, правило по %{HTTPS} даёт бесконечный редирект.
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# Старые адреса pro-nas.pro (Tilda)
RewriteRule ^tpost/s9j3yz7m31-eco-pro-na-forume-novii-reteil-2026/?$ /blog/eco-pro-new-retail-forum-2026/ [L,R=301]
RewriteRule ^tpost/tp0careij1-vremya-ustraneniya-vmesto-kolichestva-na/?$ /blog/time-to-fix-vs-violation-count/ [L,R=301]
RewriteRule ^tpost/rgiuuhcz31-situatsionnii-tsentr-pro-test-ot-nablyud/?$ /blog/pro-test-situation-center/ [L,R=301]
RewriteRule ^tpost/4ljdfc4g71-iskusstvennii-intellekt-i-mashinnoe-zren/?$ /blog/ai-computer-vision-loss-prevention/ [L,R=301]
RewriteRule ^members/login/?$ /account/ [L,R=301]
RewriteRule ^policy/?$ /privacy-policy/ [L,R=301]
RewriteRule ^agreement/?$ /consent/ [L,R=301]
RewriteRule ^(template|romashki)/?$ / [L,R=301]

# Старые адреса этого сайта на транслите → английские (21.10.2026, карта — specs/reports/update-2026-10-21.md)
RewriteRule ^napravleniya/situacionnyy-centr/?$ /services/situation-center/ [L,R=301]
RewriteRule ^napravleniya/videoanalitika-i-ii/?$ /services/video-analytics-ai/ [L,R=301]
RewriteRule ^napravleniya/cifrovye-cheklisty/?$ /services/digital-checklists/ [L,R=301]
RewriteRule ^napravleniya/analitika-incidentov/?$ /services/incident-analytics/ [L,R=301]
RewriteRule ^napravleniya/sistemy-bezopasnosti/?$ /services/security-systems/ [L,R=301]
RewriteRule ^otrasli/riteyl/?$ /industries/retail/ [L,R=301]
RewriteRule ^otrasli/proizvodstvo-i-logistika/?$ /industries/manufacturing-logistics/ [L,R=301]
RewriteRule ^otrasli/horeca/?$ /industries/horeca/ [L,R=301]
RewriteRule ^keisy/raspoznavanie-lic/?$ /cases/face-recognition/ [L,R=301]
RewriteRule ^keisy/pustye-polki/?$ /cases/empty-shelves/ [L,R=301]
RewriteRule ^keisy/ocheredi-na-kassah/?$ /cases/checkout-queues/ [L,R=301]
RewriteRule ^keisy/tehnika-bezopasnosti/?$ /cases/safety-rules/ [L,R=301]
RewriteRule ^keisy/tihiy-sabotazh/?$ /cases/quiet-sabotage/ [L,R=301]
RewriteRule ^keisy/bunt-logistov/?$ /cases/logistics-team-revolt/ [L,R=301]
RewriteRule ^keisy/horeca-servis/?$ /cases/horeca-service/ [L,R=301]
RewriteRule ^keisy/utechka-plana-optimizacii/?$ /cases/optimization-plan-leak/ [L,R=301]
RewriteRule ^keisy/bunt-regionalnyh-direktorov/?$ /cases/regional-directors-revolt/ [L,R=301]
RewriteRule ^keisy/tenevaya-shema-v-logistike/?$ /cases/shadow-logistics-scheme/ [L,R=301]
RewriteRule ^keisy/anomalnoe-skoplenie-tovara/?$ /cases/abnormal-stock-buildup/ [L,R=301]
RewriteRule ^keisy/otkrytaya-dver-sklada/?$ /cases/open-warehouse-door/ [L,R=301]
RewriteRule ^keisy/fiktivnye-vozvraty/?$ /cases/fake-returns/ [L,R=301]
RewriteRule ^blog/eco-pro-na-forume-novyy-reteyl-2026/?$ /blog/eco-pro-new-retail-forum-2026/ [L,R=301]
RewriteRule ^blog/vremya-ustraneniya-vmesto-kolichestva-narusheniy/?$ /blog/time-to-fix-vs-violation-count/ [L,R=301]
RewriteRule ^blog/ii-i-mashinnoe-zrenie-v-predotvrashchenii-poter/?$ /blog/ai-computer-vision-loss-prevention/ [L,R=301]
RewriteRule ^blog/situacionnyy-centr-pro-test/?$ /blog/pro-test-situation-center/ [L,R=301]
RewriteRule ^napravleniya/?$ /services/ [L,R=301]
RewriteRule ^otrasli/?$ /industries/ [L,R=301]
RewriteRule ^keisy/?$ /cases/ [L,R=301]
RewriteRule ^dokumenty/?$ /documents/ [L,R=301]
RewriteRule ^lichnyy-kabinet/?$ /account/ [L,R=301]
RewriteRule ^politika-konfidencialnosti/?$ /privacy-policy/ [L,R=301]
RewriteRule ^soglasie/?$ /consent/ [L,R=301]

# Адреса без слеша → со слешем (статический экспорт с trailingSlash)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_URI} !\.[a-z0-9]+$ [NC]
RewriteRule ^(.*)$ /$1/ [L,R=301]

ErrorDocument 404 /404.html

# config.php с токенами — не отдавать наружу
<Files "config.php">
  Require all denied
</Files>
# Журналы обработчика заявок
RedirectMatch 404 ^/api/logs/

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>
